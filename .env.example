# Ask TwinX live model (OpenAI). Copy to .env.local and add your key.
# .env.local is git-ignored. Restart the dev server / rebuild after editing.
VITE_OPENAI_API_KEY=sk-your-key-here
# optional:
VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_OPENAI_BASE=https://api.openai.com/v1   # point at a proxy to keep the key off the client
